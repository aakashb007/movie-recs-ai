<?xml version="1.0" encoding="utf-8"?>
<!-- Only what is listed moves. The API keys live in datastore/secrets, which is never listed. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="reelwise.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="reelwise.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
